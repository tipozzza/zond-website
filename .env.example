# ─────────────────────────────────────────────────────────────
# Резеда (email). Используется в /api/contact, /api/booking, /api/cart/submit.
# Бесплатный тариф 100 писем/день — резерверуем resend.com.
# Без этих переменных формы будут возвращать ошибку отправки.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SALES_EMAIL=office@zondreklama.ru

# ─────────────────────────────────────────────────────────────
# Админка: ключ для подписи cookie-сессий.
# Сгенерируй любым способом: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-32-byte-hex
ADMIN_PASSWORD=replace-me

# ─────────────────────────────────────────────────────────────
# GitHub API: админка пишет в репозиторий (news, portfolio, cart-leads).
# Personal Access Token с правом `repo`.
# ─────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tipozzza
GITHUB_REPO=zond-website
GITHUB_BRANCH=main

# ─────────────────────────────────────────────────────────────
# Telegram-бот для уведомлений о заявках с /outdoor (корзина).
# ОПЦИОНАЛЬНО — если не задано, /api/cart/submit просто пропустит
# Telegram-канал и отправит только email.
#
# Как настроить (5 шагов):
#   1. Открыть @BotFather в Telegram → /newbot → название и @username.
#   2. Скопировать выданный токен → TELEGRAM_BOT_TOKEN.
#   3. Создать чат/канал для уведомлений и добавить туда бота
#      (бот должен быть админом канала или участником чата).
#   4. Получить chat_id: написать любое сообщение в чат, затем
#      открыть https://api.telegram.org/bot<TOKEN>/getUpdates
#      и найти "chat":{"id":...}. Для каналов id отрицательный.
#   5. Залить обе переменные в Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Яндекс.Карты (опционально, нужно для components/YandexMap.tsx).
# Если не задано — карта будет грузиться без ключа, может быть rate-limit.
# Зарегистрировать: developer.tech.yandex.ru/services/3
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# ─────────────────────────────────────────────────────────────
# Бот «Команда ZOND» в мессенджере MAX (app/api/max/*).
# Токен — из business.max.ru (Чат-боты → Расширенные настройки → Токен).
# ─────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_GROUP_ID=-76182011947666
MAX_ADMIN_USER_ID=
# Секрет вебхука (5-256 симв., A-Z a-z 0-9 дефис) — задаётся при подписке и проверяется в /api/max/webhook
MAX_WEBHOOK_SECRET=
# Секрет для защиты /api/max/cron и /api/max/setup
MAX_CRON_SECRET=
# Базовый URL сайта (для регистрации вебхука); если пусто — берётся origin запроса
SITE_URL=https://zondreklama.ru
